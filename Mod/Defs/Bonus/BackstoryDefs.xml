        <title>gun runner</title>
        <titleFemale>gun runner</titleFemale>
        <titleShort>gun runner</titleShort>
        <titleShortFemale>gun runner</titleShortFemale>

        <description>[PAWN_nameDef] moved weapons across the Rim for people who preferred not to ask where they came from or where they were going.\n\n[PAWN_pronoun] learned to hide cargo, deal with dangerous customers, and use the merchandise when deals went bad.</description>

        <skillGains>
            <Shooting>3</Shooting>
