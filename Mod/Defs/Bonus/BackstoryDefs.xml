    <BackstoryDef>
        <defName>WeaponTraitFiddler_Gunsmith</defName>
        <identifier>WeaponTraitFiddler_Gunsmith</identifier>
        <slot>Adulthood</slot>

        <title>gunsmith</title>
        <titleFemale>gunsmith</titleFemale>
        <titleShort>gunsmith</titleShort>
        <titleShortFemale>gunsmith</titleShortFemale>

        <description>[PAWN_nameDef] trained under a master gunsmith and eventually became a journeyman, building, repairing, and modifying firearms independently. [PAWN_pronoun] knows every part of a weapon like his own body and can tell a good barrel from a bad one by licking it.</description>

        <skillGains>
            <Crafting>5</Crafting>
            <Shooting>2</Shooting>
        </skillGains>

        <requiredWorkTags>
            <li>Crafting</li>
