        <title>gunsmith's child</title>
        <titleFemale>gunsmith's child</titleFemale>
        <titleShort>gunsmith's son</titleShort>
        <titleShortFemale>gunsmith's daughter</titleShortFemale>

        <description>[PAWN_nameDef] grew up in a gunsmith's workshop surrounded by gunpowder, barrels, and triggers. [PAWN_pronoun] learned early that a firearm was a machine to be understood and admired, not merely a weapon to be fired.</description>

        <skillGains>
            <Shooting>2</Shooting>
            <Crafting>4</Crafting>
        </skillGains>

        <requiredWorkTags>
