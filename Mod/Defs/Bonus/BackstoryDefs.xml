    <!-- ========================================================= -->
    <!-- CHILDHOOD BACKSTORIES                                     -->
    <!-- ========================================================= -->

    <BackstoryDef>
        <defName>WeaponTraitFiddler_GunslingersChild</defName>
        <identifier>WeaponTraitFiddler_GunslingersChild</identifier>
        <slot>Childhood</slot>

        <title>gunslinger's child</title>
        <titleFemale>gunslinger's child</titleFemale>
        <titleShort>gunslinger's son</titleShort>
        <titleShortFemale>gunslinger's daughter</titleShortFemale>

        <description>[PAWN_nameDef] was raised by a gunslinger who treated weapons with respect and practicality. [PAWN_possessive] parent never aimed a loaded weapon at anything that did not deserve to be destroyed.\n\n[PAWN_nameDef] learned to recognize firearms by sound and spent childhood helping to maintain weapons.</description>

        <skillGains>
            <Shooting>6</Shooting>
            <Crafting>1</Crafting>
        </skillGains>

        <requiredWorkTags>
            <li>Shooting</li>
            <li>Crafting</li>
        </requiredWorkTags>

        <possessions>
            <WeaponTraitFiddler_WeaponUpgrade_QuickReload>1</WeaponTraitFiddler_WeaponUpgrade_QuickReload>
            <WeaponTraitFiddler_WeaponUpgrade_StabilizerBrace>1</WeaponTraitFiddler_WeaponUpgrade_StabilizerBrace>
        </possessions>

        <spawnCategories>
            <li>Child</li>
            <li>Colonist</li>
        </spawnCategories>

        <shuffleable>true</shuffleable>
    </BackstoryDef>


